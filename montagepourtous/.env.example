# Copier ce fichier en « .env » (ou définir ces variables chez l'hébergeur)
PORT=3100
# Mot de passe de l'espace administrateur (liste des inscrits, export CSV). Au moins 10 caractères. Valeur ci-dessous = PROVISOIRE (aussi utilisée si rien n'est défini) : à changer.
MPT_ADMIN_PASSWORD=Admin-MPT-ChangezMoi-2026
# Dossier des données (inscrits). Par défaut : ./data
MPT_DATA_DIR=
# Mettre 1 derrière un proxy HTTPS (LWS, Nginx…) pour que les cookies soient « Secure »
MPT_TRUST_PROXY=1
