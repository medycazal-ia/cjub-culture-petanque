# Copier ce fichier en « .env » (ou définir ces variables chez l'hébergeur : cPanel > Setup Node.js App > Environment variables)
PORT=3100
# Mot de passe de l'espace administrateur (liste des inscrits, compteur d'usage, export CSV). 10 caractères minimum.
# La valeur ci-dessous est PROVISOIRE (utilisée aussi si rien n'est défini) : à changer.
MPT_ADMIN_PASSWORD=Admin-MPT-ChangezMoi-2026
# Derrière HTTPS / proxy de l'hébergeur : mettre 1
MPT_TRUST_PROXY=1

# --- Base de données MySQL / MariaDB (recommandé en ligne) ---
# Si MPT_DB_NAME est renseigné, les données sont enregistrées dans la base (tables mpt_*, créées automatiquement).
# Sinon : simple fichier data/db.json.
# Sur cPanel, les noms sont préfixés par votre compte, ex. : moncompte_montagepourtous
MPT_DB_HOST=localhost
MPT_DB_PORT=3306
MPT_DB_NAME=
MPT_DB_USER=
MPT_DB_PASSWORD=

# Dossier du fichier db.json (mode sans base) et import initial. Par défaut : ./data
MPT_DATA_DIR=
